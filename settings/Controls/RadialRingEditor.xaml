<UserControl
    x:Class="Keychain.Settings.Controls.RadialRingEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <SolidColorBrush x:Key="SectorNormalBrush" Color="{ThemeResource ControlFillColorDefault}" />
        <SolidColorBrush x:Key="SectorSelectedBrush" Color="{ThemeResource SystemAccentColor}" />
        <SolidColorBrush x:Key="SectorChildBrush" Color="{ThemeResource SystemAccentColorLight2}" />
        <SolidColorBrush x:Key="SectorDisabledBrush" Color="{ThemeResource ControlFillColorDisabled}" />
        <SolidColorBrush x:Key="SectorStrokeBrush" Color="{ThemeResource DividerStrokeColorDefault}" Opacity="0.7" />
        <SolidColorBrush x:Key="HubBrush" Color="{ThemeResource ControlFillColorSecondary}" />
    </UserControl.Resources>

    <StackPanel Spacing="8">
        <Canvas x:Name="RingCanvas" Width="360" Height="360"
                HorizontalAlignment="Left"
                Background="Transparent"
                AutomationProperties.Name="Radial sector assignment diagram" />
        <TextBlock x:Name="RingNameText"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   AutomationProperties.Name="Ring name caption" />
    </StackPanel>
</UserControl>
