<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Keychain.Settings.Pages.GeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="36,24,36,24">
    <StackPanel Spacing="8" MaxWidth="760" HorizontalAlignment="Left">
      <TextBlock Text="General" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,12"/>

      <StackPanel Spacing="4" Margin="0,0,0,16">
        <ToggleSwitch x:Name="EnabledSwitch" Header="Enable Keychain" OnContent="Enabled" OffContent="Disabled"
                      Toggled="OnEnabledToggled" AutomationProperties.Name="Enable Keychain"/>
        <TextBlock Text="When disabled, the hotring gesture stays inactive until re-enabled." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      </StackPanel>

      <StackPanel Spacing="4" Margin="0,0,0,16">
        <ToggleSwitch x:Name="StartupSwitch" Header="Start Keychain when I sign in" OnContent="On" OffContent="Off"
                      Toggled="OnStartupToggled" AutomationProperties.Name="Launch at startup"/>
        <TextBlock Text="Registers a per-user startup entry (no administrator required)." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      </StackPanel>

      <StackPanel Spacing="4" Margin="0,0,0,16">
        <ToggleSwitch x:Name="TraySwitch" Header="Show tray icon" OnContent="Shown" OffContent="Hidden"
                      Toggled="OnTrayToggled" AutomationProperties.Name="Show tray icon"/>
        <TextBlock Text="The tray icon opens settings, switches profiles, pauses input, resets hooks, and exits." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      </StackPanel>

      <StackPanel Spacing="8" Margin="0,0,0,16">
        <TextBlock Text="Immediate control" Style="{StaticResource BodyStrongTextBlockStyle}"/>
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Button x:Name="PauseButton" Content="Pause hotring input now" Click="OnPauseNowClick" AutomationProperties.Name="Pause hotring input now"/>
          <ProgressRing x:Name="BusyRing" IsActive="False" Width="20" Height="20" Visibility="Collapsed"/>
        </StackPanel>
        <TextBlock x:Name="PauseState" Text="" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      </StackPanel>

      <StackPanel Spacing="8" Margin="0,0,0,16">
        <TextBlock Text="Gesture tutorial" Style="{StaticResource BodyStrongTextBlockStyle}"/>
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Button Content="Show gesture tutorial" Click="OnTutorialClick" AutomationProperties.Name="Show gesture tutorial"/>
          <CheckBox x:Name="TutorialDone" Content="Mark tutorial as completed" Checked="OnTutorialDoneToggled" Unchecked="OnTutorialDoneToggled" AutomationProperties.Name="Mark tutorial completed"/>
        </StackPanel>
      </StackPanel>

      <InfoBar x:Name="PageStatus" IsOpen="False" IsClosable="True"/>
    </StackPanel>
  </ScrollViewer>
</Page>
