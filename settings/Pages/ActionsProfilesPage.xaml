<Page
    x:Class="Keychain.Settings.Pages.ActionsProfilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Keychain.Settings.Controls"
    xmlns:pages="using:Keychain.Settings.Pages"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel x:Name="Root" Spacing="16" Margin="24,16,24,24" MaxWidth="1100" HorizontalAlignment="Left">

            <!-- ================= PROFILES ================= -->
            <TextBlock Text="Profiles" Style="{StaticResource SubtitleTextBlockStyle}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox x:Name="ProfileCombo" Width="260" Header="Active profile"
                          AutomationProperties.Name="Active profile"
                          SelectionChanged="OnProfileSelected" />
                <Button x:Name="NewProfileButton" Content="New" Click="OnNewProfileClick"
                        AutomationProperties.Name="New profile" />
                <Button x:Name="RenameProfileButton" Content="Rename" Click="OnRenameProfileClick"
                        AutomationProperties.Name="Rename profile" />
                <Button x:Name="DuplicateProfileButton" Content="Duplicate" Click="OnDuplicateProfileClick"
                        AutomationProperties.Name="Duplicate profile" />
                <Button x:Name="DeleteProfileButton" Content="Delete" Click="OnDeleteProfileClick"
                        AutomationProperties.Name="Delete profile" />
            </StackPanel>
            <TextBox x:Name="ProfileExclusionsBox" Width="600" MinHeight="64" Header="Foreground exclusions for this profile (one executable name per line, e.g. game.exe)"
                     TextWrapping="Wrap" AcceptsReturn="True"
                     AutomationProperties.Name="Profile foreground exclusions"
                     LostFocus="OnProfileExclusionsChanged" />

            <!-- ================= RINGS ================= -->
            <TextBlock Text="Rings and sector assignment" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox x:Name="RingCombo" Width="260" Header="Ring"
                          AutomationProperties.Name="Ring selector"
                          SelectionChanged="OnRingSelected" />
                <Button x:Name="AddChildRingButton" Content="Add child ring" Click="OnAddChildRingClick"
                        AutomationProperties.Name="Add child ring" />
                <Button x:Name="RemoveChildRingButton" Content="Remove child ring" Click="OnRemoveChildRingClick"
                        AutomationProperties.Name="Remove child ring" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="24" VerticalAlignment="Top">
                <local:RadialRingEditor x:Name="RingEditor" AutomationProperties.Name="Radial ring editor" />
                <StackPanel Spacing="12" Width="360" VerticalAlignment="Center">
                    <ComboBox x:Name="SectorActionCombo" Header="Action assigned to selected sector"
                              AutomationProperties.Name="Sector action assignment"
                              SelectionChanged="OnSectorActionSelected" />
                    <TextBlock x:Name="SectorHint" TextWrapping="Wrap" Opacity="0.8"
                               Text="Click a sector in the diagram, then choose the action it triggers. A child-ring sector opens a second ring while the gesture is held (250 ms hover dwell); right-click goes back." />
                </StackPanel>
            </StackPanel>

            <!-- ================= ACTIONS ================= -->
            <TextBlock Text="Actions" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="AddActionButton" Content="Add action" Click="OnAddActionClick"
                        AutomationProperties.Name="Add action" />
                <Button x:Name="DeleteActionButton" Content="Delete action" Click="OnDeleteActionClick"
                        AutomationProperties.Name="Delete action" />
                <Button x:Name="ActionUpButton" Content="Move up" Click="OnActionUpClick"
                        AutomationProperties.Name="Move action up" />
                <Button x:Name="ActionDownButton" Content="Move down" Click="OnActionDownClick"
                        AutomationProperties.Name="Move action down" />
                <Button x:Name="ImportButton" Content="Import..." Click="OnImportClick"
                        AutomationProperties.Name="Import configuration" />
                <Button x:Name="ExportButton" Content="Export..." Click="OnExportClick"
                        AutomationProperties.Name="Export configuration" />
                <Button x:Name="RestoreDefaultsButton" Content="Restore defaults" Click="OnRestoreDefaultsClick"
                        AutomationProperties.Name="Restore default configuration" />
            </StackPanel>
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ListView x:Name="ActionsList" Grid.Column="0" MinHeight="180" MaxHeight="320"
                          Header="Actions"
                          AutomationProperties.Name="Actions list"
                          SelectionChanged="OnActionSelected">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="pages:ActionListItem">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Bind Glyph}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind Label}" />
                                <TextBlock Text="{x:Bind TypeSummary}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel Grid.Column="1" Spacing="10" MinWidth="380">
                    <TextBox x:Name="ActionLabelBox" Header="Label"
                             AutomationProperties.Name="Action label"
                             LostFocus="OnActionFieldChanged" />
                    <ComboBox x:Name="ActionTypeCombo" Header="Type" AutomationProperties.Name="Action type"
                              SelectionChanged="OnActionTypeChanged">
                        <ComboBoxItem Tag="None" Content="None" />
                        <ComboBoxItem Tag="LaunchApp" Content="Launch app (.exe / .lnk)" />
                        <ComboBoxItem Tag="OpenFile" Content="Open file" />
                        <ComboBoxItem Tag="OpenFolder" Content="Open folder" />
                        <ComboBoxItem Tag="OpenUrl" Content="Open URL (http/https)" />
                        <ComboBoxItem Tag="SendShortcut" Content="Send shortcut (key chord)" />
                        <ComboBoxItem Tag="WindowsAction" Content="Windows action" />
                        <ComboBoxItem Tag="OpenKeychainSettings" Content="Open Keychain settings" />
                        <ComboBoxItem Tag="OpenChildRing" Content="Open child ring" />
                    </ComboBox>
                    <StackPanel x:Name="TargetPanel" Spacing="10">
                        <TextBox x:Name="ActionTargetBox" Header="Target (path or URL)"
                                 AutomationProperties.Name="Action target"
                                 LostFocus="OnActionFieldChanged" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="BrowseFileButton" Content="Browse file..." Click="OnBrowseTargetClick"
                                    AutomationProperties.Name="Browse for file" />
                            <Button x:Name="BrowseFolderButton" Content="Browse folder..." Click="OnBrowseFolderClick"
                                    AutomationProperties.Name="Browse for folder" />
                        </StackPanel>
                        <TextBox x:Name="ActionArgumentsBox" Header="Arguments (kept separate from the executable path)"
                                 AutomationProperties.Name="Action arguments"
                                 LostFocus="OnActionFieldChanged" />
                        <TextBox x:Name="ActionWorkingDirBox" Header="Working directory (optional)"
                                 AutomationProperties.Name="Action working directory"
                                 LostFocus="OnActionFieldChanged" />
                    </StackPanel>
                    <StackPanel x:Name="ChordPanel" Spacing="10">
                        <TextBox x:Name="ActionChordBox" Header="Shortcut chord (e.g. Ctrl+Shift+Esc)"
                                 AutomationProperties.Name="Shortcut chord"
                                 LostFocus="OnActionFieldChanged" />
                        <TextBlock Text="The chord is sent after you physically release the activation keys, and only if the foreground window has not changed." TextWrapping="Wrap" Opacity="0.8" />
                    </StackPanel>
                    <StackPanel x:Name="WindowsActionPanel" Spacing="10">
                        <ComboBox x:Name="WindowsActionCombo" Header="Windows action"
                                  AutomationProperties.Name="Windows action"
                                  SelectionChanged="OnActionFieldChanged">
                            <ComboBoxItem Tag="Documents" Content="Documents" />
                            <ComboBoxItem Tag="Downloads" Content="Downloads" />
                            <ComboBoxItem Tag="FileExplorer" Content="File Explorer" />
                            <ComboBoxItem Tag="Notepad" Content="Notepad" />
                            <ComboBoxItem Tag="WindowsSettings" Content="Windows Settings" />
                            <ComboBoxItem Tag="TaskManager" Content="Task Manager" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel x:Name="ChildRingPanel" Spacing="10">
                        <ComboBox x:Name="ChildRingCombo" Header="Child ring"
                                  AutomationProperties.Name="Child ring target"
                                  SelectionChanged="OnActionFieldChanged" />
                    </StackPanel>
                    <TextBox x:Name="IconGlyphBox" Header="Icon glyph (short text shown inside the sector)"
                             AutomationProperties.Name="Icon glyph"
                             LostFocus="OnActionFieldChanged" />
                    <StackPanel x:Name="ApprovedPanel" Orientation="Horizontal" Spacing="8">
                        <CheckBox x:Name="ApprovedCheck" Content="I have reviewed this target and approve running it"
                                  AutomationProperties.Name="Approve action target"
                                  Click="OnActionFieldChanged" />
                    </StackPanel>
                    <CheckBox x:Name="EnabledCheck" Content="Enabled"
                              AutomationProperties.Name="Action enabled"
                              Click="OnActionFieldChanged" />
                </StackPanel>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>
